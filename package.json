{
  "name": "@kesi/sdk-nodejs",
  "main": "./dist/api/index.js",
  "types": "./api/types.d.ts",
  "exports": {
    ".": {"types": "./api/types.d.ts", "default": "./dist/api/index.js"},
    "./api": {"types": "./api/types.d.ts", "default": "./dist/api/index.js"},
    "./api/client": {"types": "./api/types.d.ts", "default": "./dist/api/client.js"},
    "./api/getclient": "./dist/api/getclient.js",
    "./algorithm": "./dist/algorithm/index.js",
    "./config": "./dist/config/index.js",
    "./data_relay": "./dist/data_relay/index.js",
    "./driver": "./dist/driver/index.js",
    "./driver/command": "./dist/driver/command.js",
    "./flow": "./dist/flow/index.js",
    "./flow_extension": "./dist/flow_extension/index.js",
    "./service": "./dist/service/index.js",
    "./task": "./dist/task/index.js",
    "./log": "./dist/log/index.js",
    "./register": "./dist/register/index.js",
    "./conn/*": "./dist/conn/*/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsx scripts/clean.ts && tsc -p tsconfig.json && tsx scripts/build.ts",
    "test": "npm run build && node --test dist/api/*.test.js dist/config/*.test.js dist/conn/mq/*.test.js dist/driver/*.test.js dist/data_relay/*.test.js dist/flow/*.test.js",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felix-186/sdk-nodejs.git"
  },
  "homepage": "https://github.com/felix-186/sdk-nodejs#readme",
  "bugs": {
    "url": "https://github.com/felix-186/sdk-nodejs/issues"
  },
  "author": "ZhangQiang",
  "license": "MIT",
  "bundleDependencies": [],
  "dependencies": {
    "@grpc/grpc-js": "1.10.9",
    "@grpc/proto-loader": "^0.7.2",
    "amqplib": "^0.8.0",
    "async": "^2.6.2",
    "compression": "^1.8.2",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "etcd3": "^1.1.2",
    "express": "5.0.0",
    "js-base64": "^3.7.7",
    "kafkajs": "^2.2.4",
    "koffi": "^3.3.2",
    "lodash": "^4.17.11",
    "moment": "^2.27.0",
    "mqtt": "^5.0.5",
    "node-schedule": "^1.3.2",
    "rc": "^1.2.8",
    "sm-crypto": "^0.3.13",
    "uuid": "^8.3.2",
    "winston": "^3.10.0",
    "ws": "8.17.1",
    "yaml": "^2.9.1"
  },
  "deprecated": false,
  "description": "kesi NodeJS开发基础库",
  "devDependencies": {
    "@babel/cli": "^7.4.4",
    "@babel/core": "^7.4.5",
    "@babel/preset-env": "^7.4.5",
    "@types/node": "^26.6.3",
    "mocha": "^10.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": ["dist", "api/types.d.ts", "README.md", "README_en.md"],
  "publishConfig": {
